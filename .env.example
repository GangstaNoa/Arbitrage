# Everything below is optional. With none of this set, the app runs exactly
# as before: fully local, no accounts, no network calls beyond the fonts
# bundled at build time.
#
# Set these to enable cross-device sync (PC <-> phone) through Supabase and
# a passcode gate. None of these are NEXT_PUBLIC_* — they're only read on
# the server, so they never reach the browser bundle.

# From your Supabase project's Settings -> API page.
SUPABASE_URL=
# The "service_role" secret key (NOT the anon/public key). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# A passcode you choose. Once set, every device must enter it once (stored
# in an httpOnly cookie for 30 days) before the app is reachable.
APP_PASSCODE=
# A long random string used to sign session cookies, e.g. `openssl rand -hex 32`.
APP_SESSION_SECRET=
